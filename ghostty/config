# =============================================================================
# Ghostty Configuration
# ~/.config/ghostty/config  (Ghostty 1.3+ / macOS)
# =============================================================================

# -- Theme --------------------------------------------------------------------
# macOS の外観モードに追従(ライト: Ayu Light / ダーク: Ayu)
theme = light:Ayu Light,dark:Ayu

# -- Font ---------------------------------------------------------------------
# HackGen(白源) = Hack + 源柔ゴシック。既定の JetBrains Mono は日本語を持たず、
# macOS の優先言語が en-JP だとフォールバックで中国語字形が選ばれるため明示する。
# 半角:全角 = 1:2 なので CJK 混在でも罫線と表組みが揃う。Nerd Font 同梱
font-family = HackGen Console NF
font-size = 12

# -- Window -------------------------------------------------------------------
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
# 確認なしで閉じ、次回起動時にウィンドウ状態を復元する
window-save-state = always
confirm-close-surface = false
macos-titlebar-style = tabs

# -- macOS specific -----------------------------------------------------------
# Option key as Alt (required for terminal shortcuts like Alt+B, Alt+F)
macos-option-as-alt = true

# -- Input --------------------------------------------------------------------
mouse-hide-while-typing = true

# -- Claude Code compatibility ------------------------------------------------
# Shift+Enter works natively in Ghostty, but if issues arise uncomment:
# keybind = shift+enter=text:\n

# -- Shell integration --------------------------------------------------------
# 未指定の機能はデフォルト値が使われる(cursor / title / path はデフォルト有効)。
# デフォルト無効の sudo と SSH 統合(1.2.0+)のみ明示的に有効化する
shell-integration-features = sudo,ssh-terminfo,ssh-env

# -- Clipboard ----------------------------------------------------------------
# 選択テキストをシステムクリップボードにもコピー(デフォルト true は選択クリップボードのみ)
copy-on-select = clipboard

# -- Notifications ------------------------------------------------------------
# 非フォーカス時、5秒以上かかったコマンドの完了をデスクトップ通知する(1.3.0+)
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
