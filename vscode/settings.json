  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.env.osx": {
    "CW_NEW_SESSION": "1",
    "FIG_NEW_SESSION": "1",
    "PYTHONPATH": "${workspaceFolder}/.venv/bin/python",
    "Q_NEW_SESSION": "1"
  },
  "workbench.colorTheme": "Light Modern",
  "workbench.iconTheme": "vscode-icons",
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!If",
    "!If sequence",
    "!Not",
    "!Not sequence",
    "!Equals",
    "!Equals sequence",
    "!Or",
    "!Or sequence",
    "!FindInMap",
    "!FindInMap sequence",
    "!Base64",
    "!Join",
    "!Join sequence",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!Sub sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!ImportValue sequence",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence"
  ],
  // HackGen を先頭に置く。macOS の優先言語が en-JP だと Chromium 系は
  // 日本語を中国語字形(PingFang SC)でフォールバックするため明示指定が要る
  "editor.fontFamily": "'HackGen Console NF', Menlo, monospace",
  "terminal.integrated.fontFamily": "'HackGen Console NF', Menlo, monospace",
  "editor.tabSize": 2,
  "jupyter.widgetScriptSources": [
    "jsdelivr.com",
    "unpkg.com"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "dvc.pythonPath": "",
  "terminal.integrated.copyOnSelection": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "quarto.render.renderOnSave": true,
  "jupyter.interactiveWindow.creationMode": "perFile",
  "r.rpath.mac": "/opt/homebrew/bin/R",
  "r.bracketedPaste": true,
  "explorer.confirmPasteNative": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "git.openRepositoryInParentFolders": "never",
  "files.trimTrailingWhitespace": true,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]",
    "Todo"
  ],
  "todo-tree.filtering.includeHiddenFiles": true,
  "files.insertFinalNewline": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.scrollback": 3000,
  "geminicodeassist.project": "",
  "chat.agent.maxRequests": 100,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "aws.cloudformation.telemetry.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "geminicodeassist.displayInlineContextHint": false,
  "editor.formatOnSave": true,
  "vsicons.dontShowNewVersionMessage": true,
  "window.confirmSaveUntitledWorkspace": false,
}
